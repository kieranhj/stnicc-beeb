@echo off
rem bin\beebasm.exe is an old Cygwin build that no longer runs; default to the native beebasm 1.11 in D:\tools\beeb\Bin.
if "%BEEBASM%"=="" set BEEBASM=..\..\Bin\beebasm.exe
mkdir build
echo Building HiGH...
%BEEBASM% -D _QUALITY=2 -D _NULA=0  -i stnicc-beeb.asm -v > build\high.txt
echo Building MEDIUM...
%BEEBASM% -D _QUALITY=1 -D _NULA=0  -i stnicc-beeb.asm -v > build\medium.txt
echo Building LOW...
%BEEBASM% -D _QUALITY=0 -D _NULA=0  -i stnicc-beeb.asm -v > build\low.txt
echo Building NULA...
%BEEBASM% -D _QUALITY=1 -D _NULA=-1 -i stnicc-beeb.asm -v > build\nula.txt
echo Building CPC...
%BEEBASM% -D _QUALITY=1 -D _NULA=-1 -D _CPC=-1 -i stnicc-beeb.asm -v > build\cpc.txt
echo Building INTRO...
%BEEBASM% -i src\intro.asm -v > build\intro.txt
echo Building OUTRO...
%BEEBASM% -i src\outro.asm -v > build\outro.txt
echo Building MUSIC...
%BEEBASM% -i src\music.asm -v > build\music.txt
echo Building DISC 1...
%BEEBASM% -i stnicc-build.asm -do build\part-1.ssd -title BEEB-NICCC-1 -opt 3 -v > compile.txt
echo Building DISC 2...
%BEEBASM% -i src\part-2.asm -title BEEB-NICCC-2 -do build\part-2.ssd
rem echo Building DISC 3...
rem %BEEBASM% -i src\part-3.asm -title STNICCC-3 -do build\part-3.ssd
rem echo Building DISC 4...
rem %BEEBASM% -i src\part-4.asm -title STNICCC-4 -do build\part-4.ssd
echo Building COMBINED DISCS...
del /Q build\*.dsd
bin\bbcim -interss sd build\part-1.ssd build\part-2.ssd build\beeb-niccc.dsd
rem bin\bbcim -interss sd build\part-3.ssd build\part-4.ssd build\stnicc-B.dsd
echo Building the COLUMN DISCS' OUTROS...
%BEEBASM% -D _NO_STREAM=-1 -i src\outro.asm -v > build\outron.txt
%BEEBASM% -D _COLS=-1 -i src\outro.asm -v > build\outroc2.txt
echo Building the COLUMN DISC (the CPC version from the column stream)...
%BEEBASM% -D _CPC_ONLY=-1 -i src\intro.asm -v > build\introc.txt
%BEEBASM% -i stnicc-cols.asm -v > build\cols.txt
%BEEBASM% -i stnicc-cols-build.asm -do build\cols-1.ssd -title BEEB-NICCC-C -opt 3 -v > build\cols-build.txt
%BEEBASM% -i src\part-2-cols.asm -title BEEB-NICCC-D -do build\cols-2.ssd
bin\bbcim -interss sd build\cols-1.ssd build\cols-2.ssd build\beeb-niccc-cpc.dsd
echo Building the 1800-FRAME COLUMN DISC (every frame, from the version 2 column stream)...
%BEEBASM% -i stnicc-cols2.asm -v > build\cols2.txt
%BEEBASM% -i stnicc-cols2-build.asm -do build\cols2-1.ssd -title BEEB-NICCC-E -opt 3 -v > build\cols2-build.txt
%BEEBASM% -i src\part-2-cols2.asm -title BEEB-NICCC-F -do build\cols2-2.ssd
bin\bbcim -interss sd build\cols2-1.ssd build\cols2-2.ssd build\beeb-niccc-cpc1800.dsd
