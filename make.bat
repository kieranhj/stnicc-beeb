@echo off
rem bin\beebasm.exe is an old Cygwin build that no longer runs; default to a native beebasm 1.11 alongside this repo.
if "%BEEBASM%"=="" set BEEBASM=..\beebasm\beebasm.exe
mkdir build
echo Building HiGH...
%BEEBASM% -D _QUALITY=2 -D _NULA=0  -i stnicc-beeb.asm -v > build\high.txt
echo Building MEDIUM...
%BEEBASM% -D _QUALITY=1 -D _NULA=0  -i stnicc-beeb.asm -v > build\medium.txt
echo Building LOW...
%BEEBASM% -D _QUALITY=0 -D _NULA=0  -i stnicc-beeb.asm -v > build\low.txt
echo Building NULA...
%BEEBASM% -D _QUALITY=1 -D _NULA=-1 -i stnicc-beeb.asm -v > build\nula.txt
echo Building INTRO...
%BEEBASM% -i src\intro.asm -v > build\intro.txt
echo Building OUTRO...
%BEEBASM% -i src\outro.asm -v > build\outro.txt
echo Building MUSIC...
%BEEBASM% -i src\music.asm -v > build\music.txt
echo Building DISC 1...
%BEEBASM% -i stnicc-build.asm -do build\part-1.ssd -title BEEB-NICCC-1 -opt 3 -v > compile.txt
echo Building DISC 2...
%BEEBASM% -i src\part-2.asm -title BEEB-NICCC-2 -do build\part-2.ssd
rem echo Building DISC 3...
rem %BEEBASM% -i src\part-3.asm -title STNICCC-3 -do build\part-3.ssd
rem echo Building DISC 4...
rem %BEEBASM% -i src\part-4.asm -title STNICCC-4 -do build\part-4.ssd
echo Building COMBINED DISCS...
del /Q build\*.dsd
bin\bbcim -interss sd build\part-1.ssd build\part-2.ssd build\beeb-niccc.dsd
rem bin\bbcim -interss sd build\part-3.ssd build\part-4.ssd build\stnicc-B.dsd
